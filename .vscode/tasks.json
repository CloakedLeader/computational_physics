{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C++: Debug Build",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "-O0",
                "-g",
                "-Wall",
                "-Wextra",
                "-I/usr/include/eigen3",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "type": "cppbuild",
            "label": "C++: Release Build",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "-O3",
                "-march=native",
                "-DNDEBUG",
                "-Wall",
                "-Wextra",
                "-I/usr/include/eigen3",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}_release"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        }
    ],
    "version": "2.0.0"
}